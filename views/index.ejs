<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Recipe Builder</title>
  <link rel="shortcut icon" href="favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1"> 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    
  <link rel="stylesheet" href="font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
  <header>
    <nav>
    <div class="logo-title">
      <img src="img/sprout.png" alt="logo recipe builder ">
      <a href="/"><h3 class="title">Recipe Builder</h3></a>
    </div>
    <div>
      <a href="#allRecipes" class="btn btn-xl btn-nav"></span> Discover recipes</a>
      <a href="/#" class="btn btn-xl btn-nav"></span>My recipes</a>
      <a href="/#" class="btn btn-xl btn-nav"></span>Meal plans</a>
    <div>
    </nav>
  </header>
 <main>
   <section class="container-intro">
    <a href="/#" class="btn btn-xl btn-nav"><span class="fa fa-arrow-left"> Back</a>
    <h2>Build a new recipe</h2>
    <p>A little inspiration. A few good ingredients. Something delicious.</p> 
  </section>
  <section class="recipe-builder">
    <section class="container-card">
      <div class="form-field">
      <label for="adornField" class="form-label">INGREDIENTS</label>
      <label class="form-control form-adorn">
        <div class="form-adorn-icon" aria-hidden="true">
          <svg class="bi" width="16" height="16"><use href="#search" /></svg>
        </div>
        <input type="search" class="form-ghost" id="adornField" placeholder="Search...">
      </label>
      <small class="form-text">Find an ingredient. We’ll take care of the numbers.</small>
    </section>
      <form action="/recipes" method="POST" class="container-card">
        <label for="fieldText" class="form-label" >Recipe title</label>
        <input name="title" type="text" class="form-control input-card" id="fieldText" placeholder="Sunshine chickpea & quinoa bowls">
        <label for="fieldTextarea" class="form-label">Description</label>
        <input name="description" type="text" class="form-control input-card" id="fieldText" placeholder="Fluffy quinoa, chickpeas and crisp vegetables, tossed in a simple lemon dressing">
        <label for="fieldSelect" class="form-label">Catergory</label>
        <select name="category" class="form-control" id="fieldSelect">
          <option selected>Choose one</option>
          <option value="Breakfast">Breakfast</option>
          <option value="Lunch">Lunch</option>
          <option value="Dinner">Dinner</option>
          <option value="Snack">Snack</option>
          <option value="Dessert">Dessert</option>
          <option value="Drink">Drink</option>
        </select>
        <label for="fieldSelect" class="form-label">Servings</label>
        <div class="form-range" data-bs-bubble>
          <input name="servings" type="range" class="form-range-input" min="0" max="10" step="1" id="range3">
        </div>
        <div class="container-total-time">
        <label for="fieldText" class="form-label">Prep (min)</label>
        <input name="preptime" type="number" class="form-control input-card" id="fieldText" placeholder="15">
        <label for="fieldText" class="form-label">Cook (min)</label>
        <input name="cooktime" type="number" class="form-control input-card" id="fieldText" placeholder="15">
        </div>
        <div class="two-columns">
          <p>Total time:<strong id="total-time"> 0</strong> min </p>
        </div>
         <label for="fieldSelect" class="form-label">Difficulty</label>
        <select name="difficulty" class="form-control" id="fieldSelect">
          <option selected>Choose one</option>
          <option value="Easy">Easy</option>
          <option value="Medium">Medium</option>
          <option value="Hard">Hard</option>
        </select>
        <label for="fieldTextarea" class="form-label">Instructions</label>
        <textarea name="instructions" class="form-control" id="fieldTextarea" rows="3" placeholder="1. Warm the cooked quinoa and drained chickpeas in a pan with a splash of water for 10 minutes. Let cool slightly."></textarea>
        <div class="container-btns">
          <button type="submit" class="btn-outline theme-inverse">Save Recipe</button>
          <button type="button" class="btn-outline theme-danger">Clean</button>
        <div>
      </form>
  </section>
 </main>
<section class="container" id="allRecipes">
  <section class="container-intro">
    <h2>All recipes</h2>
    <p>Help your path to health goals with happiness</p> 
  </section>
  <section class="container-recipes">
        <% if (recipes.length === 0) { %>
            <p>There is no menu yet</p>
        <% }else{ %>
        <% recipes.forEach((recipe,i) => { %>        
            <!--<section class="card <%= i >= 4 ? 'is-hidden' : '' %>">-->
           <section class="card">
            <img src='/img/over-nightoats.jpg' class="card-img-top" class="img-recipe"">
            <div class="card-body">
              <div>
                <span class="badge badge-subtle theme-info"><%= recipe.category %></span>
                <span class="badge badge-subtle theme-accent">Servings: <%= recipe.servings %></span>
              <div>
                <h4 class="card-title"><%= recipe.title %></h4>
                <p class="card-text"><%= recipe.description %></p>
                <div class="container-btns">
                  <button type="button" class="btn-outline theme-inverse">See full recipe
                    <span class="fa fa-arrow-right"></span>
                  </button>
                  <button type="button" class="btn-solid theme-warning btn-edit" data-id="<%= recipe._id %>"aria-label="Icon only">
                    <span class="fa fa-pencil"></span>
                  </button>
                  <button type="button" class="btn-solid theme-danger btn-delete" data-id="<%= recipe._id %>" aria-label="Icon only">
                    <span class="fa fa-trash"></span>
                  </button>
                </div>
              </div>
          </section>
        <% }) %>
        <% } %>
        </section>  
        <% if (recipes.length > 4) { %>
            <section class="menu-more">
            <button type="button" id="toggle-menu" class="btn-secondary btn-lg">View full menu</button>
            </section>
        <% } %>
            
  </section> 
     <dialog id="dialog-edit-recipe">
      <h3>Update Recipe</h3>
      <form method="dialog" id="form-edit-recipe">
        <input type="hidden" name="recipeId">
      <label for="fieldText" class="form-label" >Recipe title</label>
        <input name="title" type="text" class="form-control input-card" id="fieldText" placeholder="Sunshine chickpea & quinoa bowls">
        <label for="fieldTextarea" class="form-label">Description</label>
        <input name="description" type="text" class="form-control input-card" id="fieldText" placeholder="Fluffy quinoa, chickpeas and crisp vegetables, tossed in a simple lemon dressing">
        <label for="fieldSelect" class="form-label">Catergory</label>
        <select name="category" class="form-control" id="fieldSelect">
          <option selected>Choose one</option>
          <option value="Breakfast">Breakfast</option>
          <option value="Lunch">Lunch</option>
          <option value="Dinner">Dinner</option>
          <option value="Snack">Snack</option>
          <option value="Dessert">Dessert</option>
          <option value="Drink">Drink</option>
        </select>
        <label for="fieldSelect" class="form-label">Servings</label>
        <div class="form-range" data-bs-bubble>
          <input name="servings" type="range" class="form-range-input" min="0" max="10" step="1" id="range3">
        </div>
        <div class="container-total-time">
        <label for="fieldText" class="form-label">Prep (min)</label>
        <input name="preptime" type="number" class="form-control input-card" id="fieldText" placeholder="15">
        <label for="fieldText" class="form-label">Cook (min)</label>
        <input name="cooktime" type="number" class="form-control input-card" id="fieldText" placeholder="15">
        </div>
        <div class="two-columns">
          <p>Total time:<strong id="total-time"> 0</strong> min </p>
        </div>
         <label for="fieldSelect" class="form-label">Difficulty</label>
        <select name="difficulty" class="form-control" id="fieldSelect">
          <option selected>Choose one</option>
          <option value="Easy">Easy</option>
          <option value="Medium">Medium</option>
          <option value="Hard">Hard</option>
        </select>
        <label for="fieldTextarea" class="form-label">Instructions</label>
        <textarea name="instructions" class="form-control" id="fieldTextarea" rows="3" placeholder="1. Warm the cooked quinoa and drained chickpeas in a pan with a splash of water for 10 minutes. Let cool slightly."></textarea>
        <div class="container-btns">
          <button type="submit" class="btn-outline theme-inverse">Save Recipe</button>
          <button type="button" class="btn-outline theme-danger" id="edit-cancel">Cancel</button>
        <div>
  </dialog>
<section>
<script src="main.js"></script>

</body>
</html>
